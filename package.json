  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.3",
    "mocha": "^11.7.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18",
