  "type": "module",
  "scripts": {
    "audit:deps": "node scripts/audit-dependencies.mjs",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "build": "vite build",
    "build:nginx": "vite build",
    "chunk:init-surface-decorations": "node scripts/initialize-surface-decoration-table.ts",
    "chunk:mine-block": "node scripts/mine-block.ts",
    "chunk:record-block-change": "node scripts/record-block-change.ts",
    "chunk:sync-surface-decorations": "node --loader ts-node/esm scripts/sync-surface-decoration-rules.ts",
    "chunk:verify-generated-block": "node scripts/verify-generated-block.ts",
    "civilization:settle-power": "node --loader ts-node/esm scripts/civilization-settle-power.ts",
